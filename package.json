{
  "name": "discord-presence-api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build && node --watch dist/index.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "pretest": "npm run build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "brands": "node scripts/generate-brands.mjs",
    "fonts": "node scripts/fetch-fonts.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.8",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "simple-icons": "^16.33.0",
    "typescript": "^6.0.3"
  }
}
