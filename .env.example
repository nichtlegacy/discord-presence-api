# Snowflakes this instance is allowed to render. Comma separated, no default.
ALLOWED_USER_IDS=400672307833733121

# Set to false to skip dcdn.dstn.to (banner, bio, pronouns, connections).
ENABLE_DCDN=true

# Cache lifetimes in seconds.
PRESENCE_TTL=60
PROFILE_TTL=300
IMAGE_TTL=3600

# Upstream guards.
FETCH_TIMEOUT_MS=5000
MAX_FETCH_BYTES=2000000

# Profile view counting. Needs a writable /data (compose mounts a volume).
ENABLE_VIEWS=false
VIEWS_FILE=/data/views.json
VIEWS_FLUSH_MS=10000

# Per-IP rate limit.
RATE_LIMIT=60
RATE_WINDOW_MS=60000

# Card defaults for this instance, as a query string. Request parameters win.
# DEFAULT_PARAMS=hideStatus=true&hideTag=true&hideBadges=true

# Enable only when a trusted reverse proxy sets X-Forwarded-For.
TRUST_PROXY=false

PORT=8080

# Host port the reverse proxy targets (compose).
HOST_PORT=9242
